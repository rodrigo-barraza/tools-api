{
  "name": "tools-service",
  "version": "0.1.0",
  "description": "Unified data aggregator API — events, market, products, trends, weather",
  "type": "module",
  "main": "boot.js",
  "scripts": {
    "start": "node boot.js",
    "dev": "nodemon --legacy-watch boot.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rodrigo-barraza/utilities-library": "git+https://github.com/rodrigo-barraza/utilities-library.git",
    "bignumber.js": "^10.0.2",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "cheerio": "^1.2.0",
    "convert-units": "^2.3.4",
    "crawlee": "^3.16.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "diff": "^8.0.4",
    "express": "^5.2.1",
    "jsonpath-plus": "^10.4.0",
    "minio": "^8.0.7",
    "mongodb": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.59.1",
    "pyright": "^1.1.409",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "twilio": "^6.0.2",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.1.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "ws": "^8.20.0",
    "xml2js": "^0.6.2",
    "yahoo-finance2": "^3.14.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}

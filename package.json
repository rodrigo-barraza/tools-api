{
  "name": "tools-service",
  "version": "0.2.0",
  "description": "Unified data aggregator API — events, market, products, trends, weather",
  "type": "module",
  "main": "dist/boot.js",
  "scripts": {
    "start": "node dist/boot.js",
    "dev": "tsx watch src/boot.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rodrigo-barraza/utilities-library": "github:rodrigo-barraza/utilities-library",
    "ajv": "^8.20.0",
    "bignumber.js": "^10.0.2",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "cheerio": "^1.2.0",
    "convert-units": "^2.3.4",
    "crawlee": "^3.16.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "diff": "^8.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonpath-plus": "^10.4.0",
    "mammoth": "^1.12.0",
    "minio": "^8.0.7",
    "mongodb": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.59.1",
    "postject": "^1.0.0-alpha.6",
    "pyright": "^1.1.409",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "technicalindicators": "^3.1.0",
    "twilio": "^6.0.2",
    "typescript": "next",
    "typescript-language-server": "^5.1.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "whoiser": "^2.0.0-beta.10",
    "workspace-service": "github:rodrigo-barraza/workspace-service",
    "ws": "^8.20.0",
    "xml2js": "^0.6.2",
    "yahoo-finance2": "^3.14.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/diff": "^8.0.0",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.5"
  }
}
